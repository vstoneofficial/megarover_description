    <collision>
      <origin rpy="0 0 -1.5708" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://megarover_description/meshes/f120a/base_link.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>
  <joint name="right_wheel_joint" type="continuous">
    <origin rpy="0 0 0" xyz="0.108 -0.202 0.085"/>
    <parent link="base_link"/>
    <child link="right_wheel_1"/>
    <axis xyz="0.0 1.0 0.0"/>
  </joint>
  <link name="right_wheel_1">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="3.3"/>
      <inertia ixx="6.647813e-03" ixy="0.0" ixz="0.0" iyy="1.192125e-02" iyz="0.0" izz="6.647813e-03"/>
    </inertial>
    <visual>
      <origin rpy="0 0 -1.5708" xyz="-0.108 0.202 -0.085"/>
      <geometry>
        <mesh filename="package://megarover_description/meshes/f120a/right_wheel_1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin rpy="1.5708 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.05" radius="0.085"/>
      </geometry>
    </collision>
  </link>
  <joint name="left_wheel_joint" type="continuous">
    <origin rpy="0 0 0" xyz="0.108 0.202 0.085"/>
    <parent link="base_link"/>
    <child link="left_wheel_1"/>
    <axis xyz="0.0 1.0 0.0"/>
  </joint>
  <link name="left_wheel_1">
