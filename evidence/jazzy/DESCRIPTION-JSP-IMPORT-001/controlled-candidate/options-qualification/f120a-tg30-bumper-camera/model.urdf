      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="3.3"/>
      <inertia ixx="6.647813e-03" ixy="0.0" ixz="0.0" iyy="1.192125e-02" iyz="0.0" izz="6.647813e-03"/>
