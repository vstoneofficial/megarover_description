      <mass value="26.5"/>
      <inertia ixx="2.862913e-01" ixy="-1.109256e-05" ixz="4.327049e-03" iyy="3.703059e-01" iyz="8.886529e-07" izz="5.773479e-01"/>
    </inertial>
    <visual>
      <origin rpy="0 0 -1.5708" xyz="0 0 0"/>
